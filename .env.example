APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
UPLOAD_DISK=secure_uploads
UPLOAD_MAX_SIZE_MB=30
UPLOAD_MAX_EXPANDED_SIZE_MB=100
UPLOAD_DOWNLOAD_RATE_PER_MINUTE=60
UPLOAD_PREVIEW_RATE_PER_MINUTE=120
UPLOAD_SECURITY_EVIDENCE_ENABLED=true
UPLOAD_HOSTING_SCANNER=monarx
UPLOAD_INTEGRITY_CHECK_ENABLED=true
UPLOAD_MALWARE_SCAN_ENABLED=false
UPLOAD_MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

SECURITY_HEADERS_ENABLED=true
SECURITY_LOGIN_ATTEMPTS_PER_MINUTE=5
SECURITY_LOGIN_IP_ATTEMPTS_PER_MINUTE=30
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_MODE=report-only

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOCAL_AI_ENDPOINT=
LOCAL_AI_MODEL=llama3.1

# AI provider selection: gemini, openai, or fallback
AI_PROVIDER=gemini
# Optional. If blank, the app uses Google's generateContent endpoint for AI_MODEL.
GEMINI_API_ENDPOINT=
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_AUTO_INSIGHTS=false
AI_CACHE_TTL=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

IDP_ENABLED=true
IDP_BASE_URL=https://identity-provider.isaxbsit2027.com
IDP_AUTH_URL=https://identity-provider.isaxbsit2027.com/api/v1/auth/authorize
IDP_AUTH_REQUEST_MODE=login
IDP_LOGIN_PATH=/login
IDP_CALLBACK_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_TOKEN_URL=https://identity-provider.isaxbsit2027.com/api/v1/auth/token
IDP_ME_URL=https://identity-provider.isaxbsit2027.com/api/v1/me
## IDP_FALLBACK_EMAIL removed (fallback login disabled)
IDP_VERIFY_TLS=true
IDP_ENFORCE_STATE=true

GUISIS_API_KEY=
GUISIS_CLIENT_ID=
GUISIS_CLIENT_SECRET=
GUISIS_VERIFY_TLS=true

AUDIT_LOG_PRUNE_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=730

CAMPUS_NAME="PUP Taguig Branch"

PUPTAS_BASE_URL=https://puptas.undraftedbsit2027.com
PUPTAS_CLIENT_ID=
PUPTAS_CLIENT_SECRET=
PUPTAS_SCOPE=program-read
PUPTAS_VERIFY_TLS=true
